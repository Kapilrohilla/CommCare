HTTP_PORT=3000
ENV=development

AWS_REGION=us-east-1
AWS_S3_BUCKET=my-bucket
AWS_ACCESS_KEY_ID=my-access-key-id
AWS_SECRET_ACCESS_KEY=my-secret-access-key

DEFAULT_STORAGE_VENDOR=s3

# Database
WRITER_DB_HOST=localhost
WRITER_DB_PORT=5432
WRITER_DB_USER=postgres
WRITER_DB_PASSWORD=postgres
WRITER_DB_NAME=postgres

READER_DB_HOST=localhost
READER_DB_PORT=5432
READER_DB_USER=postgres
READER_DB_PASSWORD=postgres
READER_DB_NAME=postgres

# Observability
METRICS_ENABLED=true
METRICS_PATH=/metrics
SERVICE_NAME=commcare
LOG_LEVEL=info

# Redis (docker/docker-compose.infra.yaml → localhost; full stack → redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false

# Kafka (docker/docker-compose.infra.yaml → localhost:9092; full stack → kafka:9092)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=commcare
KAFKA_GROUP_ID=commcare-group
KAFKA_SUBSCRIBER=NONE

# BullMQ (requires Redis)
BULLMQ_SCHEDULER_ENABLED=false
BULLMQ_CONSUMERS_ENABLED=false
BULLMQ_SUBSCRIBER=NONE
BULLMQ_WORKER_CONCURRENCY=5
BULLMQ_UI_ENABLED=true
BULLMQ_UI_PATH=/admin/queues

# Asterisk AMI (for asterisk-cdr-worker)
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=your_ami_user
AMI_SECRET=your_ami_secret

# Local dev only — Docker Compose overrides this for asterisk-cdr-worker
WEBHOOK_URL=http://localhost:3000/pbx/asterisk/cdr/webhook
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRIES=3

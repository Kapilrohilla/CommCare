# Asterisk container env — copy to docker/asterisk/.env
# Must stay in sync with CommCare app .env (see env-sample ARI_* / AMI_*)

# ARI (maps to ARI_USER / ARI_PASSWORD in CommCare .env)
ASTERISK_ARI_USER=commcare
ASTERISK_ARI_PASSWORD=commcare-dev-secret

# AMI (maps to AMI_USERNAME / AMI_SECRET in CommCare .env)
ASTERISK_AMI_USERNAME=commcare
ASTERISK_AMI_SECRET=commcare-ami-secret

# PostgreSQL realtime DSN (same database as CommCare)
ASTERISK_DB_HOST=db
ASTERISK_DB_NAME=postgres
ASTERISK_DB_USER=postgres
ASTERISK_DB_PASSWORD=postgres
ASTERISK_DB_PORT=5432

# Dev softphone seed extensions (used by postgres init script 002)
ASTERISK_DEV_EXT_101_PASSWORD=devpass101
ASTERISK_DEV_EXT_102_PASSWORD=devpass102
